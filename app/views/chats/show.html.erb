<%# Chat page — Figma 1:217. %>
<%= turbo_stream_from "chat_#{@chat.id}_messages_#{current_user.id}" %>
<% content_for :title, chat_title(@chat) %>
<% event = @chat.event %>
<% status = membership_status_for(current_user, event) %>
<% current_user.notifications.where(chat: @chat).destroy_all %>

<div class="chat">
  <div class="chat-header">

    <%= link_to chats_path, class: "chat-link-back" do %>
      <i class="fa-regular fa-circle-left"></i>
    <% end %>

    <div class="event-pin">
      <%= link_to event_path(event), class: "event-link"  do %>
        <span class="event-pin__main">

            <% if event.activity&.photo&.attached? %>
              <%= image_tag event.activity.photo.url,
                alt: event.activity.name,
                class: "event-pin__thumb-img" %>
            <% end %>

          <span class="event-pin__text">
            <span class="event-pin__title"><%= chat_title(@chat) %></span>
            <p class="event-pin__meta">
                <i class="fa-regular fa-calendar"></i>
                <%= event.event_date.strftime("%d/%m/%Y") %>
            </p>
            <p class="event-pin__meta">
              <i class="fa-regular fa-clock"></i>
              <%= event_time_range(event) %>
            </p>
          </span>
        </span>
      <% end %>
      <span class="event-pin__side">
        <% if current_user.google_calendar_connected? %>
          <%= link_to "Add to Calendar",
                add_to_google_event_path(@event, chat_id: @chat&.id),
                class: "event-pin__calendar",
                data: { turbo_method: :post } %>
          <%= link_to "Disconnect Calendar",
                google_disconnect_path(chat_id: @chat&.id),
                class: "event-pin__calendar",
                data: { turbo_method: :delete, turbo_confirm: "Sûr ?" } %>
        <% else %>
          <%= link_to "Connect Calendar",
              "/auth/google_calendar?chat_id=#{@chat&.id}",
              class: "event-pin__calendar",
              data: { turbo: false } %>
        <% end %>
      </span>
    </div>
  </div>
  <div class="chat-content-container" data-controller="scroll">
    <ol class="chat__thread" id='messages' data-scroll-target="messages">
      <% @chat.messages.order(:created_at).each do |message| %>
        <%= render "chats/message", event: @event, message: message, current_user: current_user%>
      <% end %>
    </ol>
    <div id="new-message">
      <%= render "chats/message_form", chat: @chat, message: @message %>
    </div>
  </div>
</div>
