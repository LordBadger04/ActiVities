<%# Chat page — Figma 1:217. %>
<% content_for :title, chat_title(@chat) %>
<% event = @chat.event %>
<% status = membership_status_for(current_user, event) %>

<div class="chat">
  <header class="chat__head">
    <span class="chat__head-avatar" aria-hidden="true"></span>
    <span class="chat__head-name"><%= chat_title(@chat) %></span>
  </header>

  <% if event %>
    <%= link_to event_path(event), class: "event-pin" do %>
      <span class="event-pin__main">
        <span class="event-pin__thumb" aria-hidden="true"></span>
        <span class="event-pin__text">
          <span class="event-pin__title"><%= event.activity&.name || event.title %></span>
          <span class="event-pin__meta">
            <%= [ event_time_range(event), event.location ].compact_blank.join(" · ") %>
          </span>
        </span>
      </span>

      <span class="event-pin__side">
        <% if status.present? %>
          <span class="chip chip--lime event-pin__status"><%= status %></span>
        <% end %>
        <%# "Add to calendar" has no ICS route yet (FRONT_BLOCKERS.md §4). %>
        <span class="event-pin__calendar">Add to calendar</span>
      </span>
    <% end %>
  <% end %>

  <ol class="chat__thread">
    <% @chat.messages.order(:created_at).each do |message| %>
      <% sent = message.user_id == current_user&.id %>
      <li class="bubble <%= sent ? 'bubble--sent' : 'bubble--received' %>">
        <% unless sent %>
          <span class="bubble__author"><%= profile_display_name(profile_for(message.user)) %></span>
        <% end %>
        <span class="bubble__content"><%= message.content %></span>
      </li>
    <% end %>
  </ol>

  <%# messages#create currently saves the chat instead of the message and never sets %>
  <%# the author (FRONT_BLOCKERS.md §2.4), so nothing is persisted yet. %>
  <%= form_with url: chat_messages_path(@chat), class: "message-footer" do %>
    <label class="visually-hidden" for="message_content">Message</label>
    <%= text_field_tag "message[content]", nil, id: "message_content",
                       class: "message-footer__input", placeholder: "Message…",
                       autocomplete: "off" %>
    <button type="submit" class="message-footer__send" aria-label="Send message">
      <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
    </button>
  <% end %>
</div>
