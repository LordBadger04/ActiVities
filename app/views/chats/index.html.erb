<%# Chats — Figma 86:890 « 07 · Chats — FRONT V2 candidate ». %>
<% content_for :title, "Chats" %>

<div class="chats" data-controller="switch-btn">
  <div class="chats__heading">
    <h1 class="chats__title">Chats</h1>
  </div>

  <%= render "shared/switch_btn", left: "Coming", right: "Passed" %>

  <div class="chats__list">
    <% if @chats.any? %>
      <% @chats.each do |chat| %>
        <%= render "chat_cards", chat: chat %>
      <% end %>
    <% else %>
      <p class="empty-state">No conversation yet.</p>
    <% end %>
  </div>
</div>
