<% request = message.user.profile.username %>
<% sent = message.user_id == current_user.id %>
<% if message.request %>
  <% unless sent %>
    <%= link_to edit_event_event_membership_path(event, message.user.event_memberships.where(event: event)[0].id),
                        data: { turbo_frame: "modal", scroll_target: "message" } do %>
      <li class="bubble <%= sent ? 'bubble--sent' : 'bubble--received' %>">
        <p><strong><%= message.content %></strong></p>
      </li>
    <% end %>
  <% else %>
    <li class="bubble <%= sent ? 'bubble--sent' : 'bubble--received' %>">
        <%= "You sent a request" %>
    </li>
  <% end %>
<% else %>
  <li class="bubble <%= sent ? 'bubble--sent' : 'bubble--received' %>" data-scroll-target="message">
    <% unless sent %>
      <span class="bubble__author"><%= profile_display_name(profile_for(message.user)) %></span>
    <% end %>
    <span class="bubble__content"><%= message.content %></span>
  </li>
<% end %>
