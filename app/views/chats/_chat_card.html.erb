<%# Ligne de conversation — Figma 86:903 « chat-row V2 ».
    La pastille « non lu » de la maquette n'est pas reprise : la table messages n'a
    aucune colonne de lecture (db/schema.rb), il n'y a donc rien à afficher ici. %>
<% event = chat.event %>
<% last = chat_last_message(chat) %>

<%# La conversation est nommée d'après les autres participants ; le titre de %>
<%# l'activité passe sur la ligne verte juste en dessous. %>
<% buddies = event.event_memberships.map(&:user).uniq.reject { |user| user == current_user } %>
<% names = buddies.map { |user| profile_display_name(profile_for(user)) } %>
<% headline = names.first || "Conversation" %>
<% headline = "#{headline} +#{names.size - 1}" if names.size > 1 %>
<% photo = buddies.first&.profile&.photo %>

<%# Horodatage façon messagerie : heure le jour même, jour de la semaine sur la %>
<%# semaine écoulée, date au-delà. Écrit ici plutôt que dans un helper : %>
<%# app/helpers appartient à la partie back de l'équipe. %>
<% stamp =
     if last.blank?
       nil
     elsif last.created_at.today?
       last.created_at.strftime("%H:%M")
     elsif last.created_at.to_date == Date.current - 1
       "Yesterday"
     elsif last.created_at > 6.days.ago
       last.created_at.strftime("%a")
     else
       last.created_at.strftime("%d/%m")
     end %>

<%= link_to chat_path(chat),
            class: "chat-row #{"event-hidden" unless event.status == "Coming"}",
            data: { switch_btn_target: event.status == "Coming" ? "left" : "right" } do %>
  <span class="chat-row__avatar">
    <% if photo&.attached? %>
      <%= cl_image_tag photo.key, crop: :fill, class: "chat-row__avatar-img", alt: "" %>
    <% else %>
      <span class="chat-row__initial" aria-hidden="true"><%= headline.first.upcase %></span>
    <% end %>
  </span>

  <span class="chat-row__body">
    <span class="chat-row__topline">
      <span class="chat-row__name"><%= headline %></span>
      <% if stamp %>
        <span class="chat-row__time"><%= stamp %></span>
      <% end %>
    </span>

    <span class="chat-row__event"><%= chat_title(chat) %></span>

    <span class="chat-row__preview">
      <%= last ? truncate(last.content, length: 48) : "No message yet" %>
    </span>
  </span>
<% end %>
