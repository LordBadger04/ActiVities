<%= simple_form_for [chat, message], class: "message-footer" do  |f| %>
  <%= f.input :content,
              input_html: { id: "message_content", class: "message-footer__input"},
              placeholder: "Message…",
              label: "",
              autocomplete: "off",
              as: :string %>

  <button type="submit" class="message-footer__send" aria-label="Send message">
    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
  </button>
<% end %>
