<%# Create an activity.
    No such screen exists in the Figma file — the maquette stops at the seven browse/detail
    frames. This follows the Stitch fill-in generated from the same design system, which is
    why it reuses the conventions of _forms.scss rather than introducing new ones.

    The blockers that used to stop this form from submitting (§1.1, §1.2) were fixed on
    master on 2026-08-26, along with the addition of the `event_date` column. %>
<% content_for :title, "Create an activity" %>

<h1 class="page-title event-form-title">Create an activity</h1>

<%= simple_form_for @event, html: { class: "event-form" } do |f| %>
  <%= render "event_form", f: f %>
  <div class="form-actions">
    <%= f.button :submit, "Create activity" %>
    <%= link_to "Cancel", events_path, class: "form-cancel" %>
  </div>
<% end %>
