<%# Activity card — Figma 1:197 / 1:152. %>
<%# The thumbnail is a flat tint block: no Active Storage yet (FRONT_BLOCKERS.md §1.3). %>
<%= link_to event_path(event),
  class: "activity-card" do %>
  <span class="activity-card__body">

    <span class="activity-card__title"><%= event.title %></span>

    <span class="activity-card__meta">
      <% if event.activity %>
        <span class="activity-card__meta-item">
          <i class="fa-solid fa-tag"></i>
          <%= event.activity.name %>
        </span>
      <% end %>

      <span class="activity-card__meta-item">
        <i class="fa-solid fa-location-dot"></i>
        <%= event.location %>
      </span>

      <% if event.event_date %>
        <span class="activity-card__meta-item activity-card__meta-item--date">
          <i class="fa-regular fa-calendar"></i>
          <%= event.event_date.strftime("%d/%m/%Y") %>
        </span>
      <% end %>

      <% if event.attributes["distance"].present? %>
        <span class="activity-card__meta-item activity-card__meta-item--distance">
          <i class="fa-solid fa-route"></i>
          <%= event.attributes["distance"].round(1) %> km
        </span>
      <% end %>
    </span>

    <% going = event.event_memberships.size %>
    <div class="activity-card__going">
      <% if going.positive? %>
        <% avatars = event.event_memberships.map { |member| member.user.profile&.photo&.key } %>
        <%= render "shared/avatars_display", avatars: avatars %>
      <% else %>
        <div class="activity-card__going-count">Be the first to join</div>
      <% end %>
    </div>
  </div>
<% end %>
