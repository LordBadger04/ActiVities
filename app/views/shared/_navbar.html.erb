<%# App header — Figma node I1:271;130:864. Deep green bar, marque à gauche, action à droite. %>
<%# The maquette's header also contains an iOS status bar (9:41 AM, wifi, battery). %>
<%# That is a mockup artifact, not UI, so it is deliberately not reproduced. %>
<header class="app-header">
  <%= link_to root_path, class: "app-header__brand", aria: { label: "ActiVities — accueil" } do %>
    <%= image_tag "activities-icon.png", alt: "ActiVities",
                  width: 48, height: 48, class: "app-header__logo" %>
  <% end %>

  <%# L'accès au profil vit désormais dans la barre du bas, seul l'onglet Profile y mène. %>
  <%# Ne reste ici que la sortie de session, qui n'existe nulle part ailleurs dans l'app. %>
  <% if user_signed_in? %>
    <%= link_to "Log out", destroy_user_session_path,
                data: { turbo_method: :delete }, class: "app-header__signin" %>
  <% else %>
    <%= link_to "Log in", new_user_session_path, class: "app-header__signin" %>
  <% end %>
</header>
