<%# App header — Figma node I1:271;130:864. Deep green bar, lime wordmark, 44px avatar. %>
<%# The maquette's header also contains an iOS status bar (9:41 AM, wifi, battery). %>
<%# That is a mockup artifact, not UI, so it is deliberately not reproduced. %>
<header class="app-header">
  <%= link_to "ActiVities", root_path, class: "app-header__wordmark" %>

  <% if user_signed_in? %>
    <div class="dropdown">
      <%# The `>` that closes this tag must stay outside the conditional — when it sat
          inside, a user with no avatar got an unterminated <button> and the browser
          reparented the dropdown <ul> *inside* it, so Bootstrap never found the menu. %>
      <button type="button"
              class="app-header__avatar"
              id="accountMenu"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Account menu"
              <% if current_profile&.photo&.attached? %>style="background-image: url('<%= cl_image_path current_profile.photo.key, crop: :fill %>')"<% end %>></button>

      <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
        <% if current_profile %>
          <li><%= link_to "My profile", profile_path(current_profile), class: "dropdown-item" %></li>
          <li><%= link_to "Create Profile", new_profile_path, class: "dropdown-item" %></li>
          <li><%= link_to "Edit profile", edit_profile_path(current_profile), class: "dropdown-item" %></li>
        <% else %>
          <li><%= link_to "Create my profile", new_profile_path, class: "dropdown-item" %></li>
        <% end %>
        <li><%= link_to "New activity", new_event_path, class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to "Log out", destroy_user_session_path,
                      data: { turbo_method: :delete }, class: "dropdown-item" %>
        </li>
      </ul>
    </div>
  <% else %>
    <%= link_to "Log in", new_user_session_path, class: "app-header__signin" %>
  <% end %>
</header>
