<%# Bottom nav — Figma component set "Bottom nav" (node 38:438), pilule flottante
    361x64, rayon 32. Glyphes Font Awesome 6 Free Solid (font-awesome-sass).
    Le quatrième onglet n'est plus « Profile » — le profil vit dans le menu compte
    du header — mais l'action « Create », traitée comme une action et non comme une
    destination : pastille lime pleine en permanence, à l'image des CTA de l'app. %>

<%# L'onglet courant est déduit du contrôleur. Volontairement résolu ici plutôt que
    via `nav_tab_active?`, qui range encore les profils sous « Buddies » — un onglet
    qui n'existe plus depuis le passage à quatre. Les pages profil n'allument plus
    aucun onglet : leur entrée est passée dans le header. %>
<% current_tab = if controller_name == "events" && %w[new create].include?(action_name)
                   :create
                 else
                   case controller_name
                   when "pages"                       then :home
                   when "events", "event_memberships" then :activities
                   when "chats", "messages"           then :chat
                   end
                 end %>

<% tabs = [
     { key: :home,       label: "Home",       icon: "fa-house",          path: root_path },
     { key: :activities, label: "Activities", icon: "fa-person-running", path: events_path },
     { key: :chat,       label: "Chats",      icon: "fa-comment",        path: chats_path },
     { key: :create,     label: "Create",     icon: "fa-plus",           path: new_event_path }
   ] %>

<div class="bottom-nav-dock">
  <nav class="bottom-nav" aria-label="Main navigation">
  <% tabs.each do |tab| %>
    <% active = (tab[:key] == current_tab) %>
    <%= link_to tab[:path],
                class: "bottom-nav__tab #{'bottom-nav__tab--active' if active} #{'bottom-nav__tab--create' if tab[:key] == :create}",
                aria: { current: ("page" if active) } do %>
      <span class="bottom-nav__slot">
        <i class="fa-solid <%= tab[:icon] %> bottom-nav__icon" aria-hidden="true"></i>
      </span>
      <span class="bottom-nav__label"><%= tab[:label] %></span>
    <% end %>
  <% end %>
</nav>
</div>
