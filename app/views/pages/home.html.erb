<%# Homepage — Figma 1:262. %>
<% content_for :title, "ActiVities" %>

<% if user_signed_in? && current_user.profile.present? %>
  <div class="home-welcome">
    <h1 class="home-welcome__title">
      Hi <%= current_user.profile.first_name %> 👋
    </h1>

    <p class="home-welcome__subtitle">
      What do you feel like doing today?
    </p>
  </div>
<% end %>

<div data-controller="geolocation">
  <%= hidden_field_tag :latitude,
      params[:latitude],
      data: { geolocation_target: "latitude" } %>

  <%= hidden_field_tag :longitude,
      params[:longitude],
      data: { geolocation_target: "longitude" } %>
</div>

<section class="home-section">
  <div class="home-section__head">
    <h2 class="section-label">Around you</h2>

    <% if @user_location.present? %>
      <button
        type="button"
        class="home-map__location-btn"
        data-controller="map-focus"
        data-action="click->map-focus#user">
        <i class="fa-solid fa-location-crosshairs"></i>
        My location
      </button>
    <% end %>
  </div>

  <div
    class="home-map"
    data-controller="map"
    data-action="
      activity:focus@window->map#focusActivity
      user:focus@window->map#focusUser
    "
    data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"
    data-map-markers-value="<%= @markers.to_json %>"
    data-map-user-location-value="<%= @user_location.to_json %>">
  </div>

  <div class="home-map__legend">
    <span class="home-map__legend-item">
      <span class="home-map__legend-dot home-map__legend-dot--user"></span>
      Your area
    </span>

    <span class="home-map__legend-item">
      <span class="home-map__legend-dot home-map__legend-dot--activity"></span>
      Approximate activity area
    </span>
  </div>
</section>



<section class="home-section">
  <div class="home-section__head">
    <h2 class="section-label">Something different</h2>
  </div>

  <div class="home__feed">
    <% if @different_events.any? %>
      <% @different_events.each do |event| %>
        <%= render "events/activity_card", event: event, show_map_button: true %>
      <% end %>
    <% else %>
      <p class="empty-state">Nothing new to suggest yet.</p>
    <% end %>
  </div>
</section>
