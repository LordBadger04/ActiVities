<%# Homepage — Figma 1:262. %>
<% content_for :title, "ActiVities - Find new buddies in real life" %>

<% if user_signed_in? && current_user.profile.present? %>
  <section class="home-hero">
    <div class="home-hero__content">
      <span class="home-hero__eyebrow">
        Ready for something new?
      </span>

      <h1 class="home-hero__title">
        Hi <%= current_user.profile.first_name %> 👋
      </h1>

      <p class="home-hero__subtitle">
        Find an activity nearby, join an event and meet people around something you already enjoy.
      </p>

      <%= link_to events_path, class: "home-hero__cta" do %>
        See activities
        <i class="fa-solid fa-arrow-right"></i>
      <% end %>
    </div>

    <div class="home-hero__visual">
      <div class="home-hero__badge home-hero__badge--top">
        <i class="fa-solid fa-location-dot"></i>
        Nearby
      </div>

      <div class="home-hero__circle">
        <i class="fa-solid fa-person-running"></i>
      </div>

      <div class="home-hero__badge home-hero__badge--bottom">
        <i class="fa-solid fa-user-group"></i>
        Meet new buddies
      </div>
    </div>
  </section>
<% end %>

<div data-controller="geolocation">
  <%= hidden_field_tag :latitude,
      params[:latitude],
      data: { geolocation_target: "latitude" } %>

  <%= hidden_field_tag :longitude,
      params[:longitude],
      data: { geolocation_target: "longitude" } %>
</div>

<section class="home-section">
  <div class="home-section__head">
    <div>
      <h2 class="section-label">Around you</h2>
      <p class="home-section__subtitle">
        Discover activities happening near your area.
      </p>
    </div>

    <% if @user_location.present? %>
      <button
        type="button"
        class="home-map__location-btn"
        data-controller="map-focus"
        data-action="click->map-focus#user">
        <i class="fa-solid fa-location-crosshairs"></i>
        My location
      </button>
    <% end %>
  </div>

  <div
    class="home-map"
    data-controller="map"
    data-action="
      activity:focus@window->map#focusActivity
      user:focus@window->map#focusUser
    "
    data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"
    data-map-markers-value="<%= @markers.to_json %>"
    data-map-user-location-value="<%= @user_location.to_json %>">
  </div>

  <div class="home-map__legend">
    <span class="home-map__legend-item">
      <span class="home-map__legend-dot home-map__legend-dot--user"></span>
      Your area
    </span>

    <span class="home-map__legend-item">
      <span class="home-map__legend-dot home-map__legend-dot--activity"></span>
      Approximate activity area
    </span>
  </div>
</section>



<section class="home-section">
  <div class="home-section__head">
    <div>
      <h2 class="section-label">Something different</h2>
      <p class="home-section__subtitle">
        Try an activity outside your usual picks.
      </p>
    </div>
  </div>

  <div class="home__feed">
    <% if @different_events.any? %>
      <% @different_events.each do |event| %>
        <%= render "events/activity_card", event: event, show_map_button: true %>
      <% end %>
    <% else %>
      <p class="empty-state">Nothing new to suggest yet.</p>
    <% end %>
  </div>
</section>

<section class="home-section home-how">
  <div class="home-section__head">
    <div>
      <h2 class="section-label">How it works</h2>
      <p class="home-section__subtitle">
        Three simple steps to turn an activity into a real-life plan.
      </p>
    </div>
  </div>

  <div class="home-how__grid">
    <div class="home-how__item">
      <div class="home-how__icon">
        <i class="fa-solid fa-compass"></i>
      </div>
      <h3>Discover</h3>
      <p>Find activities and events that match what you feel like doing.</p>
    </div>

    <div class="home-how__item">
      <div class="home-how__icon">
        <i class="fa-solid fa-hand-pointer"></i>
      </div>
      <h3>Join</h3>
      <p>Choose an event and request to take part in it.</p>
    </div>

    <div class="home-how__item">
      <div class="home-how__icon">
        <i class="fa-solid fa-people-group"></i>
      </div>
      <h3>Meet</h3>
      <p>Enjoy the activity and meet new buddies in real life.</p>
    </div>
  </div>
</section>
