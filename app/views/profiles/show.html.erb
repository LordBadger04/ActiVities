<%# User page — Figma 1:207 / component 1:209 "Usercard". %>
<% content_for :title, profile_display_name(@profile) %>
<% by_genre = profile_activities_by_genre(@profile) %>
<% sports = by_genre["Sport"].to_a %>
<% culture = by_genre["Culture"].to_a %>
<% relaxing = by_genre["Relaxing"].to_a %>

<% if current_profile == @profile %>
  <h1 class="profile-title">My profile</h1>
<% end %>
<article class="detail-sheet detail-sheet--profile">
  <header class="profile-head">
    <div class="profile-head__identity">
      <h2 class="detail-sheet__title"><%= profile_display_name(@profile) %></h2>
      <%# The maquette shows a "2.3 km" chip. No geodata exists (FRONT_BLOCKERS.md §1.5), %>
      <%# so the stored location string takes that slot. %>
      <% if @profile.location.present? %>
        <span class="chip"><%= @profile.location %></span>
      <% end %>
    </div>
    <% if @profile.photo.attached? && current_profile != @profile %>
      <%= cl_image_tag @profile.photo.key, class: "avatar-bordered avatar-large" %>
    <% end %>

  </header>

  <hr class="detail-sheet__divider">

  <section class="detail-block">
    <h2 class="section-label">About</h2>
    <p class="detail-block__body"><strong>Name:</strong><em><%= current_profile.first_name %> <%= current_profile.last_name %></em></p>
    <p class="detail-block__body"><strong>Age:</strong><em><%= current_profile.age %></em></p>
    <p class="detail-block__body"><strong>Genre:</strong><em><%= current_profile.gender %></em></p>
    <p class="detail-block__body"><strong>Languages:</strong><em><%= current_profile.language %></em></p>
    <div class="detail-block__body">
      <p class="detail-block__body"><strong>In a few Words:</strong></p>
      <p><em><%= current_profile.description %></em></p>
    </div>
  </section>

  <hr class="detail-sheet__divider">

  <%# Sports / Hobbies — Activity::GENRES is ["Sport", "Culture", "Relaxing"] and the %>
  <%# maquette has two columns, so Culture and Relaxing share the Hobbies side. %>
  <div class="interests">
    <section class="interests__col">

      <% unless by_genre.nil? %>
        <% by_genre.each  do |key, value| %>
          <h2 class="chip"><%= key %></h2>
          <div class="activity_genre">
            <% if value.any? %>
                <% value.each do |ua| %>

                  <%= render "activity_small_card", ua: ua %>

                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="interests__empty">Nothing yet</p>
      <% end %>


    </section>

  </div>

  <div class="cta-bar">
    <% if current_profile == @profile %>
      <%= link_to "Edit my profile", edit_profile_path(@profile), class: "btn-cta" %>
    <% end %>
  </div>
</article>
