<%=  simple_form_for profile do |f| %>

    <%= f.input :username,
                required: true%>
    <%= f.input :first_name,
                required: true,
                input_html: { autocomplete: "first-name" }%>
    <%= f.input :last_name,
                required: true,
                input_html: { autocomplete: "last-name" }%>
    <%= f.input :age,
                min: 0,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "age" }%>
    <%= f.input :gender,
                required: true,
                autofocus: true%>
    <%= f.input :language,
                label: "Languages spoken",
                required: true%>
    <%= f.input :location,
                label: "City",
                required: true
                %>
    <%= f.input :description,
                label: 'Describe yourself (15 letters min)',
                required: true %>

    <div class="activities_form" data-controller="add-form-input"  data-add-form-input-pattern-value="INDEX">

      <template class="target" data-add-form-input-target="formTemplate">
        <%= render "activity_form", user_activities: :user_activities, f: f%>
      </template>

      <div class="form_list" data-add-form-input-target="formList">
        <%=  f.simple_fields_for :user_activities do |t|%>
          <%= t.association :activity,
                      as: :select %>
          <%= t.input :level,
                      as: :select,
                      collection: UserActivity::LEVELS%>
        <%= t.button :button, "X",
                      class:"btn btn-danger",
                      data: { action: 'click->add-form-input#destroy' } %>
        <% end %>
      </div>

       <%= link_to "Add activities", "#",
                class: "btn btn-success",
                data: { action: 'click->add-form-input#add' } %>

    </div>

    <%= f.submit %>

  <% end %>
