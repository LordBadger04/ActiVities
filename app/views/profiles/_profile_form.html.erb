<%=  simple_form_for profile do |f| %>

    <%= f.input :username,
                required: true%>
    <%= f.input :first_name,
                required: true,
                input_html: { autocomplete: "first-name" }%>
    <%= f.input :last_name,
                required: true,
                input_html: { autocomplete: "last-name" }%>
    <%= f.input :age,
                collection: 18..60,
                as: :select,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "age" }%>
    <%= f.input :gender,
                required: true,
                autofocus: true%>
    <%= f.input :language,
                label: "Languages spoken",
                required: true%>
    <%= f.input :location,
                label: "City",
                required: true
                %>
    <%= f.input :photo, as: :file %>
    <%= f.input :description,
                label: 'Describe yourself (15 letters min)',
                required: true %>

    <div class="activities_form" data-controller="add-form-input"  data-add-form-input-pattern-value="INDEX">

      <template class="target" data-add-form-input-target="formTemplate">

        <div class="form_line" data-controller="delete-form" >
          <%=  f.simple_fields_for :user_activities, UserActivity.new, child_index: "INDEX" do |t|%>
            <%= render "activity_form", user_activities: :user_activities, t: t %>
          <% end %>
        </div>

      </template>

      <div class="form_list" data-add-form-input-target="formList">
        <%=  f.simple_fields_for :user_activities do |t|%>
        <div class="form_line">
          <%= render "activity_form", user_activities: :user_activities, t: t %>
        </div>
        <% end %>
      </div>

       <%= link_to "Add activities", "#",
                class: "btn btn-success",
                data: { action: 'click->add-form-input#add' } %>

    </div>

    <%= f.submit %>

  <% end %>
