<div class="form_line d-flex" data-controller="delete-form" data-add-form-input-target="formLine">
  <%=  f.simple_fields_for :user_activities, UserActivity.new, child_index: "INDEX" do |t|%>
    <%= t.association :activity,
                as: :select %>
    <%= t.input :level,
                as: :select,
                collection: UserActivity::LEVELS%>
  <%= t.button :button, "X",
                class:"btn btn-danger",
                data: { action: 'click->add-form-input#destroy' } %>
  <% end %>

</div>
